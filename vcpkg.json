bitcoin/
└── evidence/
    └── schemas/
        └── xa-btc-test-evidence-package.v1.0.2.schema.json

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xa-finance.ai/schemas/xa-btc-test-evidence-package.v1.0.2.schema.json",
  "title": "XaBtcTestEvidencePackageV102",
  "type": "object",
  "required": [
    "evidence_version",
    "evidence_class",
    "suite_type",
    "source_commit",
    "build_id",
    "runner_path",
    "command",
    "environment_id",
    "process_status",
    "exit_code",
    "start_time",
    "end_time",
    "result_summary",
    "logs",
    "raw_artifacts"
  ],
  "properties": {
    "evidence_version": {
      "type": "string",
      "const": "1.0.2"
    },
    "evidence_class": {
      "type": "string",
      "enum": ["SIMULATED", "OBSERVED"],
      "description": "Indica se a evidência é uma simulação sintética ou uma execução observada real."
    },
    "suite_type": {
      "type": "string",
      "enum": ["UNIT", "FUZZ", "FUNCTIONAL", "LINT"]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Commit SHA-1 exato do Bitcoin Core testado."
    },
    "build_id": {
      "type": "string",
      "description": "Identificador único ou hash do registro de build associado."
    },
    "runner_path": {
      "type": "string",
      "description": "Caminho relativo do runner executado."
    },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Comando completo e argumentos."
    },
    "environment_id": {
      "type": "string",
      "description": "Identificador do ambiente de execução."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "parallel_jobs": {
      "type": "integer",
      "minimum": 1
    },
    "cache_state": {
      "type": "object",
      "required": [
        "cache_dir",
        "existence_observed",
        "usage_status"
      ],
      "properties": {
        "cache_dir": { "type": "string" },
        "existence_observed": { "type": "boolean" },
        "usage_status": {
          "type": "string",
          "enum": ["USED", "NOT_USED", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "cache_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": false
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "pattern": ".*Z$|.*\\+00:00$",
      "description": "Timestamp ISO 8601 obrigatório em UTC."
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "pattern": ".*Z$|.*\\+00:00$",
      "description": "Timestamp ISO 8601 obrigatório em UTC."
    },
    "process_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "RUNNING",
        "COMPLETED",
        "NONZERO_EXIT",
        "TIMEOUT",
        "INTERRUPTED",
        "LAUNCH_ERROR"
      ],
      "description": "Estado real do ciclo de vida do processo executor."
    },
    "exit_code": {
      "type": ["integer", "null"],
      "description": "Código de saída real; null se o processo falhou antes de terminar."
    },
    "result_summary": {
      "type": "object",
      "required": [
        "expected",
        "executed",
        "passed",
        "failed",
        "skipped",
        "not_executed",
        "inconclusive",
        "infrastructure_failures"
      ],
      "properties": {
        "expected": { "type": ["integer", "null"], "minimum": 0 },
        "executed": { "type": ["integer", "null"], "minimum": 0 },
        "passed": { "type": ["integer", "null"], "minimum": 0 },
        "failed": { "type": ["integer", "null"], "minimum": 0 },
        "skipped": { "type": ["integer", "null"], "minimum": 0 },
        "not_executed": { "type": ["integer", "null"], "minimum": 0 },
        "inconclusive": { "type": ["integer", "null"], "minimum": 0 },
        "infrastructure_failures": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["log_path", "sha256", "size_bytes"],
        "properties": {
          "log_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_/.-]+$",
            "description": "Caminho estritamente relativo, sem travessias de diretório (../)."
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "raw_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_path",
          "artifact_type",
          "hash_algorithm",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "artifact_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_/.-]+$",
            "description": "Caminho estritamente relativo, sem travessias de diretório (../)."
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "EXECUTION_LOG",
              "TEST_REPORT",
              "CORPUS",
              "BINARY",
              "CONFIG"
            ]
          },
          "hash_algorithm": {
            "type": "string",
            "const": "SHA-256"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

